{:fennel-path "./fnl/?.fnl;./fnl/juice/?.fnl;./fnl/juice/lsp/?.fnl;./fnl/after/ftplugin/?.fnl"
 :lua-version :lua5.4
 :libraries {}
 :extra-globals "unpack vim"
 :lints {:unused-definition false
         :unknown-module-field true
         :unnecessary-method true
         :unnecessary-tset true
         :unnecessary-do true
         :redundant-do true
         :match-should-case true
         :bad-unpack true
         :var-never-set true
         :op-with-no-arguments true
         :multival-in-middle-of-call true
         :no-decreasing-comparison false}}
